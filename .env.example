# Copy to .env and fill in real values. Never commit .env.

# CoinGecko API key.
# The AIRFLOW_VAR_ prefix makes Airflow expose it as Variable "coingecko_api_key",
# so the same DAG code works in dev and prod.
AIRFLOW_VAR_COINGECKO_API_KEY=your-api-key-here

# GCP (non-secret)
GCP_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET="your-gcs-bucket"
BQ_RAW_DATASET="your-bq-raw-dataset"
